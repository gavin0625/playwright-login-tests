# 环境变量示例文件
# 复制此文件为 .env 并填入实际值

# 测试环境配置
TEST_ENV=test

# 测试目标 URL
TEST_URL=https://alliance-lms.dev.i2hk.net/

# 测试凭证
TEST_USERNAME=admin
TEST_PASSWORD=admin123!

# 浏览器配置
BROWSER=chromium
HEADLESS=true

# 超时配置（毫秒）
TIMEOUT=30000

# 慢动作模式（用于调试，毫秒）
SLOW_MO=0

# 并行测试
PARALLEL=false
WORKERS=auto

# 报告配置
GENERATE_HTML_REPORT=true
GENERATE_ALLURE_REPORT=false

# 通知配置（可选）
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=
